#cloud-config

hostname: pigcw
manage_etc_hosts: true
timezone: UTC
package_update: true
package_upgrade: false
enable_ssh: true
ssh_pwauth: true

users:
  - name: pigcw
    gecos: pigCW
    shell: /bin/bash
    groups: [audio, sudo]
    lock_passwd: false
    passwd: "$6$rounds=4096$XuyKs.O0rV/qUZ4b$UQGwTT/qI42SyKXdN.RZUJ/x7IzScPM3fPhy0V7XzaHLCW1hab5xC6ApaLTF/BZm78pwoBKaF7pXeVho5UxqA."

packages:
  - git
  - wget
  - mpg123
  - make
  - gcc
  - python3
  - python3.13-venv
  - libportaudio2
  - portaudio19-dev

write_files:
  - path: /etc/sudoers.d/pigcw-nmcli
    permissions: "0440"
    content: |
      pigcw ALL=(root) NOPASSWD: /usr/bin/nmcli

  - path: /etc/systemd/system/pigpiod.service
    permissions: "0644"
    content: |
      [Unit]
      Description=pigpio daemon
      After=network.target

      [Service]
      Type=simple
      ExecStart=/usr/local/bin/pigpiod -g -l
      Restart=on-failure
      RestartSec=2

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/pigcw.service
    permissions: "0644"
    content: |
      [Unit]
      Description=pigCW
      After=NetworkManager.service sound.target pigpiod.service
      Wants=NetworkManager.service
      Requires=pigpiod.service

      [Service]
      Type=simple
      WorkingDirectory=/srv/pigCW
      ExecStart=/srv/pigCW/.venv/bin/python -m src.pigcw
      Restart=always
      RestartSec=2
      User=pigcw

      [Install]
      WantedBy=multi-user.target

runcmd:
  - [bash, -lc, "mkdir -p /srv"]
  - [bash, -lc, "cd /srv && rm -rf pigCW && git clone https://github.com/yo3gnd/pigCW.git pigCW"]
  - [bash, -lc, "f=/srv/pigCW/dist/debian-trixie/cloud-init/pigcw1.mp3; [ -f \"$f\" ] && /usr/bin/mpg123 -q -o alsa \"$f\" || true"]
  - [bash, -lc, "chown -R pigcw:pigcw /srv/pigCW"]
  - [bash, -lc, "cd /opt && wget -O v79.tar.gz https://github.com/joan2937/pigpio/archive/refs/tags/v79.tar.gz"]
  - [bash, -lc, "cd /opt && rm -rf pigpio-79 && tar zxf v79.tar.gz"]
  - [bash, -lc, "f=/srv/pigCW/dist/debian-trixie/cloud-init/pigcw2.mp3; [ -f \"$f\" ] && /usr/bin/mpg123 -q -o alsa \"$f\" || true"]
  - [bash, -lc, "cd /opt/pigpio-79 && make && make install"]
  - [bash, -lc, "f=/srv/pigCW/dist/debian-trixie/cloud-init/pigcw3.mp3; [ -f \"$f\" ] && /usr/bin/mpg123 -q -o alsa \"$f\" || true"]
  - [bash, -lc, "ldconfig"]
  - [bash, -lc, "cd /srv/pigCW && /usr/bin/python3.13 -m venv .venv"]
  - [bash, -lc, "cd /srv/pigCW && .venv/bin/pip install numpy websocket-client paho-mqtt requests pigpio sounddevice"]
  - [bash, -lc, "chown -R pigcw:pigcw /srv/pigCW"]
  - [bash, -lc, "systemctl daemon-reload"]
  - [bash, -lc, "systemctl enable pigpiod.service"]
  - [bash, -lc, "systemctl restart pigpiod.service"]
  - [bash, -lc, "systemctl enable pigcw.service"]
  - [bash, -lc, "systemctl restart pigcw.service"]

final_message: "pigCW first boot setup finished"
